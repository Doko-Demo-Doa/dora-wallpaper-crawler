{
  "name": "dora-wallpaper-crawler",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "fetch": "bunx tsx src/crons/downloader.ts",
    "introspect": "drizzle-kit introspect:pg --config=drizzle.config.ts",
    "generate": "drizzle-kit generate:pg --config=drizzle.config.ts",
    "migrate": "bun run src/db/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cron": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "cheerio": "^1.1.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "elysia": "latest",
    "pg": "^8.16.3",
    "remeda": "^2.23.2",
    "tsx": "^4.20.3",
    "uploadthing": "^7.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/pg": "^8.15.4",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4"
  },
  "module": "src/index.js"
}
